{
  "name": "@budget-app/ui",
  "version": "0.1.0",
  "description": "Household budget app design system — React components, tokens and styles for the Budget App (Android + Windows).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "npm run dev --workspace app",
    "app:build": "npm run build --workspace app",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run app:build",
    "ui-audit": "node scripts/ui-audit.mjs",
    "app:build:uitest": "npm run build --workspace app -- --mode uitest",
    "app:build:android": "npm run build --workspace app -- --outDir dist-android",
    "dev:uitest": "vite app --mode uitest --host 127.0.0.1 --port 5177 --strictPort",
    "preview:app": "vite preview app --host 127.0.0.1 --port 4173 --strictPort",
    "preview:uitest": "vite preview app --host 127.0.0.1 --port 4174 --strictPort"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app"
  ]
}
