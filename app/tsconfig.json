{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@budget-app/ui": ["../src/index.ts"],
      "@budget-app/ui/styles.css": ["../src/styles/index.css"]
    }
  },
  "include": ["src", "harness", "vite.config.ts", "capacitor.config.ts"]
}
