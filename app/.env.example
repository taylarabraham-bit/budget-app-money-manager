# Optional defaults for the sync server (Settings lets you enter these at runtime instead).
# Copy to app/.env.local - that file is ignored by git. Never commit the real key.
# A CI or GitHub Pages build has no .env.local, so it ships with no default server:
# sync stays off until a server is entered in Settings.
VITE_SUPABASE_URL=https://laptop.tail1234.ts.net
VITE_SUPABASE_ANON_KEY=
